# ============================================================================
# Mudrax CRM — Environment Variables Template
#
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real `.env` file — only this template is tracked in git.
# See deploy/env/ for per-environment (staging/production) templates.
# ============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Read by prisma.config.ts (CLI/Migrate). The runtime Prisma Client uses a
# driver adapter configured in src/infra/db — see src/infra/db/README.md.
#
# Value below targets Postgres reached at "localhost" (host machine, whether
# Postgres is a local install or a docker-compose container with its port
# published to the host). When the Next.js app itself also runs *inside*
# docker-compose, docker-compose.yml overrides this same variable to point at
# the "postgres" service hostname instead — no other file needs to change.
DATABASE_URL="postgresql://mudrax:mudrax_dev_password@localhost:5432/mudrax_crm?schema=public"

# --- PostgreSQL container provisioning (docker-compose only) ----------------
# Consumed only by the `postgres` service in docker-compose.yml to create the
# initial role/database on first start. Keep these three in sync with the
# credentials embedded in DATABASE_URL above — they describe the same
# database from two different angles (connection string vs. container init).
POSTGRES_USER=mudrax
POSTGRES_PASSWORD=mudrax_dev_password
POSTGRES_DB=mudrax_crm
POSTGRES_PORT=5432

# --- Authentication (Auth.js) ------------------------------------------------
AUTH_SECRET=replace-with-a-strong-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Redis (infrastructure only — not yet used by any application code) -----
# Provisioned in docker-compose.yml as general-purpose infrastructure. No
# module reads REDIS_URL today; this reserves the seam documented in
# src/infra/README.md and src/infra/jobs/README.md for, e.g.:
#   - server-side session storage (if the auth solution needs one)
#   - caching (RBAC data-scope resolution, configuration, analytics)
#   - future background job/queue processing
#   - future rate limiting
#   - future distributed locking
# Introducing an actual client library (ioredis, a specific cache/queue
# package, etc.) and wiring it into src/infra is a deliberate, separate,
# future change — provisioning the service now does not imply or commit to
# that implementation.
REDIS_URL="redis://:mudrax_dev_password@localhost:6379"
REDIS_PASSWORD=mudrax_dev_password
REDIS_PORT=6379

# --- Future Integrations -----------------------------------------------------
# Uncomment and configure each block only when that integration is actually
# implemented under src/integrations/*.

# WhatsApp Business API (src/integrations/whatsapp)
# WHATSAPP_BUSINESS_API_TOKEN=
# WHATSAPP_BUSINESS_PHONE_NUMBER_ID=

# Email/SMTP (src/modules/notifications/infrastructure/channels/email)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Facebook Lead Ads (src/integrations/facebook)
# Prefer configuring Page ID / tokens in Integrations UI.
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=
# META_GRAPH_API_VERSION=v21.0
# FACEBOOK_LEAD_ADS_APP_ID=
# FACEBOOK_LEAD_ADS_APP_SECRET=

# Google (src/integrations/google, calendar, google-ads lead capture)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Telephony provider (src/integrations/telephony/*)
# TELEPHONY_PROVIDER=
