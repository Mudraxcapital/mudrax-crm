# Base URL of the Mudrax CRM Next.js app (no trailing slash).
# Use your PC's current LAN IP (ipconfig / Next.js "Network" URL) so the phone/emulator
# can reach the host — NOT an old IP, and NOT localhost from a physical device.
# Android emulator alternative: http://10.0.2.2:3000
# iOS simulator: http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

