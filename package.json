{
  "name": "mudrax-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Mudrax CRM - production Enterprise CRM for Mudrax Capitals (Loan DSA operations).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "app:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-app.ps1",
    "app:start:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-app.ps1 -FullDocker",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/restart-dev.ps1",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "jobs:worker": "tsx scripts/jobs/jobs-worker.ts",
    "jobs:tick": "tsx -e \"import('./src/infra/jobs/runner.ts').then(m => m.runJobsTick().then(r => { console.log(JSON.stringify(r,null,2)); process.exit(0); }))\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset-crm": "tsx prisma/seed/reset-crm-data.ts",
    "prepare": "husky",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:reset": "docker compose down -v",
    "mobile:dev": "npm run start -w @mudrax/mobile",
    "mobile:android": "npm run android -w @mudrax/mobile",
    "mobile:lint": "npm run lint -w @mudrax/mobile",
    "mobile:type-check": "npm run type-check -w @mudrax/mobile",
    "android": "npm run android -w @mudrax/mobile",
    "ios": "npm run ios -w @mudrax/mobile"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "15.5.21",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "redis": "^4.7.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nativewind": {
      "tailwindcss": "3.4.19",
      "react-native-css-interop": {
        "tailwindcss": "3.4.19"
      }
    },
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "expo-font": "14.0.12",
    "@expo/vector-icons": {
      "expo-font": "14.0.12"
    }
  }
}
