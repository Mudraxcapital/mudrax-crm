# ============================================================================
# Mudrax CRM — Production Environment Template (company Linux server)
#
# Copy alongside the deployment (e.g. /etc/mudrax-crm/.env) and fill in real
# production values. NEVER commit the real file.
# ============================================================================

NODE_ENV=production
PORT=3000
APP_URL=https://crm.mudraxcapitals.example
APP_VERSION=0.1.0

# --- Database ----------------------------------------------------------------
POSTGRES_USER=mudrax
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=mudrax_crm
DATABASE_URL="postgresql://mudrax:replace-with-strong-db-password@postgres:5432/mudrax_crm?schema=public"

# --- Auth.js (next-auth v5) --------------------------------------------------
AUTH_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
AUTH_URL=https://crm.mudraxcapitals.example
# Required when running behind the Nginx reverse proxy (see deploy/nginx/).
AUTH_TRUST_HOST=true

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379

# --- Background jobs ---------------------------------------------------------
JOBS_ENABLED=true
JOBS_INLINE=false
JOBS_INTERVAL_MS=60000
JOBS_KEEP_ALIVE=true
# Optional HTTP cron tick: POST /api/internal/jobs/tick
JOBS_CRON_SECRET=replace-with-a-strong-random-secret

# --- Storage -----------------------------------------------------------------
DOCUMENTS_LOCAL_STORAGE_ROOT=/app/.data
