// ============================================================================
// documents — src/modules/documents
//
// Source: ADR 0007, docs/modules/documents.md.
//
// Single write path for all document-management state. `customers`,
// `leads`, `loan_applications`, `loan_accounts`, and `disbursements` never
// duplicate document metadata — they are referenced by identity via the
// polymorphic `OwnerContext` (`ownerType` + `ownerId`) pattern below.
// ============================================================================

/// Polymorphic owner discriminator shared by Document, Document Checklist,
/// and Document Bundle. Prisma cannot express a conditional foreign key for
/// a polymorphic `ownerId` — referential integrity across the five possible
/// target tables is enforced at the application layer (or with a manual,
/// per-type trigger if strict DB-level enforcement is required).
enum DocumentOwnerType {
  CUSTOMER
  LEAD
  LOAN_APPLICATION
  LOAN_ACCOUNT
  DISBURSEMENT

  @@map("document_owner_type")
  @@schema("documents")
}

// ---------------------------------------------------------------------------
// Storage & Upload
// ---------------------------------------------------------------------------

/// Aggregate Root; one configured storage backend binding, distinguished
/// only by a `StorageProviderType` discriminator. Vendor-specific code
/// lives in `src/integrations/storage/*`, never here.
model StorageLocation {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String                @db.VarChar(150)
  providerType   StorageProviderType
  /// Bucket/region/path etc. Secret credentials are referenced by id from
  /// a centralized secrets store (platform-contracts.md §3) — never
  /// embedded inline here.
  configuration  Json                  @db.JsonB
  status         StorageLocationStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  attachments      Attachment[]
  documentVersions DocumentVersion[]

  @@index([organizationId])
  @@map("storage_locations")
  @@schema("documents")
}

enum StorageProviderType {
  LOCAL_DISK
  NAS
  S3
  AZURE_BLOB

  @@map("storage_provider_type")
  @@schema("documents")
}

enum StorageLocationStatus {
  ACTIVE
  DEPRECATED
  RETIRED

  @@map("storage_location_status")
  @@schema("documents")
}

/// One resumable/chunked/multi-file upload operation. Idempotent by session
/// token.
model UploadSession {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  initiatedByUserId String              @db.Uuid
  sessionToken      String              @unique @db.VarChar(255)
  status            UploadSessionStatus @default(INITIATED)
  totalChunks       Int?
  receivedChunks    Int                 @default(0)
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  attachments Attachment[]

  @@index([organizationId])
  @@map("upload_sessions")
  @@schema("documents")
}

enum UploadSessionStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  ABANDONED
  FAILED
  EXPIRED

  @@map("upload_session_status")
  @@schema("documents")
}

// ---------------------------------------------------------------------------
// Core File Entities
// ---------------------------------------------------------------------------

/// Aggregate Root; generic registration of any raw uploaded file, before
/// any business meaning is attached to it. Not every Attachment is promoted
/// to a Document.
model Attachment {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  uploadSessionId   String?          @db.Uuid
  uploadedByUserId  String           @db.Uuid
  fileName          String           @db.VarChar(255)
  mimeType          String           @db.VarChar(150)
  sizeBytes         BigInt
  checksum          String           @db.VarChar(128)
  storageLocationId String           @db.Uuid
  storageKey        String           @db.Text
  status            AttachmentStatus @default(UPLOADING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  uploadSession    UploadSession?    @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)
  storageLocation  StorageLocation   @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  documentVersions DocumentVersion[]

  @@index([organizationId])
  @@index([uploadSessionId])
  @@index([storageLocationId])
  @@map("attachments")
  @@schema("documents")
}

enum AttachmentStatus {
  UPLOADING
  SCANNING
  CLEAN
  INFECTED
  AVAILABLE
  PROMOTED_TO_DOCUMENT
  ARCHIVED
  PURGED

  @@map("attachment_status")
  @@schema("documents")
}

/// Admin catalog grouping Document Types (KYC, Income Proof, Collateral,
/// Loan Execution, Compliance, Other). A closed, versionable set.
model DocumentCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documentTypes     DocumentType[]
  retentionPolicies RetentionPolicy[]

  @@unique([organizationId, name])
  @@map("document_categories")
  @@schema("documents")
}

/// Admin catalog entry ("PAN Card," "Aadhaar," "Salary Slip," "Bank
/// Statement," "Photo," "Signature").
model DocumentType {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  documentCategoryId String   @db.Uuid
  name               String   @db.VarChar(150)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documentCategory       DocumentCategory        @relation(fields: [documentCategoryId], references: [id], onDelete: Restrict)
  documents              Document[]
  checklistTemplateItems ChecklistTemplateItem[]
  checklistItems         ChecklistItem[]
  retentionPolicies      RetentionPolicy[]

  @@unique([organizationId, name])
  @@index([documentCategoryId])
  @@map("document_types")
  @@schema("documents")
}

/// Aggregate Root; the business-classified, workflow-bearing wrapper built
/// on one Attachment's version lineage. Never hard-deleted before purge
/// eligibility.
model Document {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  documentTypeId String @db.Uuid

  ownerType DocumentOwnerType
  ownerId   String            @db.Uuid

  status          DocumentStatus @default(DRAFT)
  createdByUserId String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  versions       DocumentVersion[]
  checklistItems ChecklistItem[]
  bundleMembers  BundleMember[]
  legalHolds     LegalHold[]
  sharings       DocumentSharing[]

  @@index([organizationId])
  @@index([documentTypeId])
  @@index([ownerType, ownerId])
  @@map("documents")
  @@schema("documents")
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  VERIFIED
  REJECTED
  RETAINED
  ARCHIVED
  PURGE_ELIGIBLE
  PURGED

  @@map("document_status")
  @@schema("documents")
}

/// Child entity of Document; one immutable file revision. File bytes are
/// always an external Storage Reference, never inlined.
model DocumentVersion {
  id                String                @id @default(uuid()) @db.Uuid
  documentId        String                @db.Uuid
  versionNumber     Int
  attachmentId      String                @db.Uuid
  storageLocationId String                @db.Uuid
  status            DocumentVersionStatus @default(UPLOADED)
  uploadedByUserId  String                @db.Uuid
  createdAt         DateTime              @default(now())

  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attachment      Attachment      @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  ocrJobs               OcrJob[]
  verifications         DocumentVerification[]
  pinnedInBundleMembers BundleMember[]

  // MANUAL SQL FOLLOW-UP: "at most one CURRENT version per Document" is a
  // partial unique index:
  //   CREATE UNIQUE INDEX document_versions_one_current_per_document
  //     ON documents.document_versions (document_id)
  //     WHERE status = 'CURRENT';
  @@unique([documentId, versionNumber])
  @@index([attachmentId])
  @@map("document_versions")
  @@schema("documents")
}

enum DocumentVersionStatus {
  UPLOADED
  CURRENT
  SUPERSEDED
  ARCHIVED
  PURGED

  @@map("document_version_status")
  @@schema("documents")
}

// ---------------------------------------------------------------------------
// Verification & Extraction
// ---------------------------------------------------------------------------

/// Child entity of Document Version; one background text/data extraction
/// run. A reprocess always creates a new Job.
model OcrJob {
  id                String        @id @default(uuid()) @db.Uuid
  documentVersionId String        @db.Uuid
  engineType        OcrEngineType
  status            OcrJobStatus  @default(QUEUED)
  startedAt         DateTime?
  completedAt       DateTime?
  failureReason     String?       @db.Text
  createdAt         DateTime      @default(now())

  documentVersion DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  extractedFields ExtractedField[]

  @@index([documentVersionId])
  @@map("ocr_jobs")
  @@schema("documents")
}

enum OcrEngineType {
  GENERIC_OCR
  AADHAAR_OCR
  PAN_OCR
  BANK_STATEMENT_PARSER

  @@map("ocr_engine_type")
  @@schema("documents")
}

enum OcrJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("ocr_job_status")
  @@schema("documents")
}

/// Child entity of OCR Job; one recognized key/value with a confidence
/// score. Always advisory; never auto-writes into another module's trusted
/// state.
model ExtractedField {
  id               String               @id @default(uuid()) @db.Uuid
  ocrJobId         String               @db.Uuid
  fieldKey         String               @db.VarChar(150)
  fieldValue       String               @db.Text
  confidence       Decimal              @db.Decimal(5, 4)
  status           ExtractedFieldStatus @default(EXTRACTED)
  reviewedByUserId String?              @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())

  ocrJob OcrJob @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)

  @@index([ocrJobId])
  @@map("extracted_fields")
  @@schema("documents")
}

enum ExtractedFieldStatus {
  EXTRACTED
  REVIEWED
  CONFIRMED
  OVERRIDDEN

  @@map("extracted_field_status")
  @@schema("documents")
}

/// Independent Aggregate Root; one decision cycle confirming a specific,
/// pinned Document Version is genuine, legible, and correct.
model DocumentVerification {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  documentVersionId String             @db.Uuid
  method            VerificationMethod
  status            VerificationStatus @default(PENDING)
  verifiedByUserId  String?            @db.Uuid
  verifiedAt        DateTime?
  rejectionReason   String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([documentVersionId])
  @@map("document_verifications")
  @@schema("documents")
}

enum VerificationMethod {
  MANUAL
  OCR_ASSISTED
  EKYC

  @@map("verification_method")
  @@schema("documents")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_RESUBMISSION
  ESCALATED

  @@map("verification_status")
  @@schema("documents")
}

// ---------------------------------------------------------------------------
// Checklist & Bundling
// ---------------------------------------------------------------------------

/// Aggregate Root; reusable definition of required Document Types. Global
/// by default (`loanProductId = null`), or scoped to one Loan Product by
/// reference (never embedded).
model DocumentChecklistTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  // Cross-schema, optional reference to loan_products.LoanProduct.id.
  loanProductId  String?        @db.Uuid
  name           String         @db.VarChar(200)
  versionNumber  Int            @default(1)
  status         TemplateStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items ChecklistTemplateItem[]

  @@index([organizationId])
  @@index([loanProductId])
  @@map("document_checklist_templates")
  @@schema("documents")
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED

  @@map("template_status")
  @@schema("documents")
}

/// One required Document Type entry with a mandatory/optional flag.
model ChecklistTemplateItem {
  id                          String  @id @default(uuid()) @db.Uuid
  documentChecklistTemplateId String  @db.Uuid
  documentTypeId              String  @db.Uuid
  isMandatory                 Boolean @default(true)

  documentChecklistTemplate DocumentChecklistTemplate @relation(fields: [documentChecklistTemplateId], references: [id], onDelete: Cascade)
  documentType              DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@unique([documentChecklistTemplateId, documentTypeId])
  @@map("checklist_template_items")
  @@schema("documents")
}

/// Independent Aggregate Root; the materialized, per-case tracking instance
/// generated from the applicable templates. Not silently recomputed if the
/// template changes mid-case.
model DocumentChecklist {
  id                          String            @id @default(uuid()) @db.Uuid
  organizationId              String            @db.Uuid
  ownerType                   DocumentOwnerType
  ownerId                     String            @db.Uuid
  materializedFromTemplateIds Json              @db.JsonB
  status                      ChecklistStatus   @default(MATERIALIZED)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  items   ChecklistItem[]
  bundles DocumentBundle[]

  @@unique([ownerType, ownerId])
  @@index([organizationId])
  @@map("document_checklists")
  @@schema("documents")
}

enum ChecklistStatus {
  MATERIALIZED
  IN_PROGRESS
  COMPLETE
  BLOCKED

  @@map("checklist_status")
  @@schema("documents")
}

/// One required-item tracking row referencing a fulfilling Document.
model ChecklistItem {
  id                   String              @id @default(uuid()) @db.Uuid
  documentChecklistId  String              @db.Uuid
  documentTypeId       String              @db.Uuid
  isMandatory          Boolean             @default(true)
  status               ChecklistItemStatus @default(PENDING)
  fulfillingDocumentId String?             @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  documentChecklist  DocumentChecklist @relation(fields: [documentChecklistId], references: [id], onDelete: Cascade)
  documentType       DocumentType      @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  fulfillingDocument Document?         @relation(fields: [fulfillingDocumentId], references: [id], onDelete: SetNull)
  bundleMembers      BundleMember[]

  @@unique([documentChecklistId, documentTypeId])
  @@index([fulfillingDocumentId])
  @@map("checklist_items")
  @@schema("documents")
}

enum ChecklistItemStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  RESUBMISSION_REQUESTED

  @@map("checklist_item_status")
  @@schema("documents")
}

/// Independent Aggregate Root; a complete, presentable, verifiable,
/// shareable package of Documents for one business process.
model DocumentBundle {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  documentChecklistId String            @db.Uuid
  ownerType           DocumentOwnerType
  ownerId             String            @db.Uuid
  /// Bundle Subject = `{subject, subjectId}` (ADR 0007). `subjectId`
  /// resolves against the specific person/asset the `subject`
  /// discriminator names — e.g. a `loan_applications.CoApplicant.id` for
  /// `CO_APPLICANT`. Cross-schema and polymorphic by `subject`, so no
  /// Prisma relation is declared; null whenever `subject = NONE`.
  subject             BundleSubject     @default(NONE)
  subjectId           String?           @db.Uuid
  name                String            @db.VarChar(200)
  status              BundleStatus      @default(BUILDING)
  lockedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  documentChecklist DocumentChecklist @relation(fields: [documentChecklistId], references: [id], onDelete: Restrict)
  members           BundleMember[]
  sharings          DocumentSharing[]

  // MANUAL SQL FOLLOW-UP: `subjectId` is required exactly when `subject`
  // is not `NONE`:
  //   ALTER TABLE documents.document_bundles
  //     ADD CONSTRAINT document_bundles_subject_id_check
  //     CHECK ((subject = 'NONE') = (subject_id IS NULL));
  @@index([organizationId])
  @@index([documentChecklistId])
  @@index([ownerType, ownerId])
  @@map("document_bundles")
  @@schema("documents")
}

enum BundleSubject {
  PRIMARY_APPLICANT
  CO_APPLICANT
  ASSET
  NONE

  @@map("bundle_subject")
  @@schema("documents")
}

enum BundleStatus {
  BUILDING
  COMPLETE
  LOCKED
  SUPERSEDED
  ARCHIVED

  @@map("bundle_status")
  @@schema("documents")
}

/// Links one Document (and, where applicable, the Checklist Item it
/// fulfills) into the Bundle. Locking a Bundle pins the exact Document
/// Version of every member at that moment.
model BundleMember {
  id                      String             @id @default(uuid()) @db.Uuid
  documentBundleId        String             @db.Uuid
  documentId              String             @db.Uuid
  checklistItemId         String?            @db.Uuid
  pinnedDocumentVersionId String?            @db.Uuid
  status                  BundleMemberStatus @default(ADDED)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  documentBundle        DocumentBundle   @relation(fields: [documentBundleId], references: [id], onDelete: Cascade)
  document              Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  checklistItem         ChecklistItem?   @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  pinnedDocumentVersion DocumentVersion? @relation(fields: [pinnedDocumentVersionId], references: [id], onDelete: SetNull)

  @@unique([documentBundleId, documentId])
  @@index([checklistItemId])
  @@index([pinnedDocumentVersionId])
  @@map("bundle_members")
  @@schema("documents")
}

enum BundleMemberStatus {
  ADDED
  ACTIVE
  REMOVED
  SUPERSEDED

  @@map("bundle_member_status")
  @@schema("documents")
}

// ---------------------------------------------------------------------------
// Retention & Legal Hold
// ---------------------------------------------------------------------------

/// Versioned, append-only rule set for how long a Document Category/Type
/// must be retained and under what trigger.
model RetentionPolicy {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  documentCategoryId    String?               @db.Uuid
  documentTypeId        String?               @db.Uuid
  retentionDurationDays Int
  triggerEvent          String                @db.VarChar(150)
  status                RetentionPolicyStatus @default(DRAFT)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  documentCategory DocumentCategory? @relation(fields: [documentCategoryId], references: [id], onDelete: SetNull)
  documentType     DocumentType?     @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("retention_policies")
  @@schema("documents")
}

enum RetentionPolicyStatus {
  DRAFT
  EFFECTIVE
  SUPERSEDED

  @@map("retention_policy_status")
  @@schema("documents")
}

/// Overrides Retention Policy's computed purge date. Purge requires policy
/// eligibility AND no active Legal Hold AND no open
/// Verification/Sharing/Bundle-lock referencing the Document.
model LegalHold {
  id              String    @id @default(uuid()) @db.Uuid
  documentId      String    @db.Uuid
  appliedByUserId String    @db.Uuid
  reason          String    @db.Text
  appliedAt       DateTime  @default(now())
  liftedByUserId  String?   @db.Uuid
  liftedAt        DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // MANUAL SQL FOLLOW-UP: "no active Legal Hold" purge precondition implies
  // at most one active (liftedAt IS NULL) hold per Document is the useful
  // invariant to index for fast lookup:
  //   CREATE UNIQUE INDEX legal_holds_one_active_per_document
  //     ON documents.legal_holds (document_id)
  //     WHERE lifted_at IS NULL;
  @@index([documentId])
  @@map("legal_holds")
  @@schema("documents")
}

// ---------------------------------------------------------------------------
// Sharing & Audit
// ---------------------------------------------------------------------------

/// Independent Aggregate Root; one controlled, time-boxed exposure of a
/// Document or Document Bundle, pinned to specific Versions. A share always
/// has an expiry.
model DocumentSharing {
  id                       String        @id @default(uuid()) @db.Uuid
  organizationId           String        @db.Uuid
  documentId               String?       @db.Uuid
  documentBundleId         String?       @db.Uuid
  pinnedDocumentVersionIds Json          @db.JsonB
  accessToken              String        @unique @db.VarChar(255)
  sharedWithEmail          String?       @db.VarChar(320)
  sharedWithPhone          String?       @db.VarChar(20)
  status                   SharingStatus @default(ACTIVE)
  expiresAt                DateTime
  createdByUserId          String        @db.Uuid
  createdAt                DateTime      @default(now())
  revokedAt                DateTime?
  revokedByUserId          String?       @db.Uuid

  document       Document?             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentBundle DocumentBundle?       @relation(fields: [documentBundleId], references: [id], onDelete: Cascade)
  accessLog      ShareAccessLogEntry[]

  // MANUAL SQL FOLLOW-UP: exactly one of documentId / documentBundleId must
  // be set:
  //   ALTER TABLE documents.document_sharings
  //     ADD CONSTRAINT document_sharings_exactly_one_target_check
  //     CHECK (num_nonnulls(document_id, document_bundle_id) = 1);
  @@index([organizationId])
  @@index([documentId])
  @@index([documentBundleId])
  @@map("document_sharings")
  @@schema("documents")
}

enum SharingStatus {
  CREATED
  ACTIVE
  EXPIRED
  REVOKED

  @@map("sharing_status")
  @@schema("documents")
}

/// One recorded access event, append-only.
model ShareAccessLogEntry {
  id                String   @id @default(uuid()) @db.Uuid
  documentSharingId String   @db.Uuid
  ipAddress         String?  @db.VarChar(64)
  userAgent         String?  @db.Text
  accessedAt        DateTime @default(now())

  documentSharing DocumentSharing @relation(fields: [documentSharingId], references: [id], onDelete: Cascade)

  @@index([documentSharingId])
  @@map("share_access_log_entries")
  @@schema("documents")
}

/// Aggregate Root, platform-level; immutable, append-only record of every
/// significant action across this bounded context. No update/delete
/// use-case is exposed at the domain layer.
model AuditTrail {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  occurredAt     DateTime  @default(now())
  actorType      ActorType
  actorId        String?   @db.Uuid
  action         String    @db.VarChar(200)
  targetType     String    @db.VarChar(100)
  targetId       String    @db.Uuid
  correlationId  String?   @db.Uuid
  beforeState    Json?     @db.JsonB
  afterState     Json?     @db.JsonB

  /// Tamper-evidence hash chain (platform-contracts.md §4): each record
  /// hashes its own content plus the previous record's hash. Computing and
  /// verifying the chain is application/trigger logic, not a Prisma
  /// concern — Prisma only preserves the two columns.
  recordHash         String  @db.VarChar(128)
  previousRecordHash String? @db.VarChar(128)

  // MANUAL SQL FOLLOW-UP: this is the canonical structurally-append-only
  // table — enforce "no UPDATE/DELETE, ever" at the database level, not
  // only by omitting application code paths:
  //   REVOKE UPDATE, DELETE ON documents.audit_trail FROM application_role;
  // Also a strong candidate for RANGE partitioning by `occurred_at` given
  // unbounded, append-only growth, mirroring the Call Attempt note above.
  @@index([organizationId])
  @@index([targetType, targetId])
  @@index([occurredAt])
  @@map("audit_trail")
  @@schema("documents")
}

enum ActorType {
  USER
  SYSTEM
  AI

  @@map("actor_type")
  @@schema("documents")
}
