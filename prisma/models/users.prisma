// ============================================================================
// users — src/modules/users
//
// Sole employee identity module for Mudrax CRM (single-company).
// Job titles (Caller, Manager, Team Lead, Admin) are fixed Roles via `rbac`.
// There is no organizationId / multi-tenant column on Users.
// ============================================================================

/// The employee identity. Roles are held via `rbac`.UserRole.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Auto-generated Mudrax Capitals staff id — format MCS0001, MCS0002, …
  employeeId      String     @unique @db.VarChar(50)
  fullName        String     @db.VarChar(200)
  email           String     @unique @db.VarChar(320)
  /// Unique when present — duplicate employee phones are rejected in User Management.
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String     @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  profilePhotoUrl String?    @db.VarChar(500)
  /// Bumped on status change / password reset — JWT must match or session is invalid.
  sessionVersion  Int        @default(0)
  /// Set on create / password reset — cleared after the user changes password.
  mustChangePassword Boolean @default(false)
  /// Temporary lockout from failed sign-in attempts (cleared by Admin unlock or expiry).
  lockedUntil  DateTime?
  lockedReason String?   @db.VarChar(200)

  assignedTeamLeadId String? @db.Uuid
  reportingManagerId String? @db.Uuid
  /// When true (Team Lead only), Admin/Manager allow delete/disable/suspend of assigned Callers.
  canManageCallerAccounts Boolean @default(false)

  // Operational membership pointers for RBAC Data Scope resolution.
  currentTeamId       String? @db.Uuid
  currentBranchId     String? @db.Uuid
  currentDepartmentId String? @db.Uuid

  mfaEnabled Boolean    @default(false)
  mfaMethod  MfaMethod?

  createdByUserId String? @db.Uuid
  updatedByUserId String? @db.Uuid

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  loginAttempts LoginAttempt[]
  sessions      UserSession[]
  apiKeys       ApiKey[]

  @@index([currentTeamId])
  @@index([currentBranchId])
  @@index([assignedTeamLeadId])
  @@index([reportingManagerId])
  @@index([status])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("users")
  @@schema("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
  @@schema("users")
}

enum MfaMethod {
  TOTP
  SMS_OTP
  EMAIL_OTP

  @@map("mfa_method")
  @@schema("users")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  emailTried    String   @db.VarChar(320)
  succeeded     Boolean
  ipAddress     String?  @db.VarChar(64)
  userAgent     String?  @db.Text
  failureReason String?  @db.VarChar(200)
  occurredAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([emailTried])
  @@index([occurredAt])
  @@map("login_attempts")
  @@schema("users")
}

/// Tracked CRM login sessions — active sessions + login history.
model UserSession {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  ipAddress      String?           @db.VarChar(64)
  userAgent      String?           @db.Text
  device         String?           @db.VarChar(80)
  browser        String?           @db.VarChar(80)
  loginAt        DateTime          @default(now())
  lastActivityAt DateTime          @default(now())
  logoutAt       DateTime?
  revokedAt      DateTime?
  revokeReason   String?           @db.VarChar(200)
  status         UserSessionStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, loginAt])
  @@map("user_sessions")
  @@schema("users")
}

enum UserSessionStatus {
  ACTIVE
  ENDED
  REVOKED

  @@map("user_session_status")
  @@schema("users")
}

model ApiKey {
  id             String        @id @default(uuid()) @db.Uuid
  ownerUserId    String        @db.Uuid
  name           String        @db.VarChar(150)
  keyHash        String        @unique @db.VarChar(255)
  keyPrefix      String        @db.VarChar(12)
  dataScope      UserDataScope
  integrationRef String?       @db.VarChar(150)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime      @default(now())

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  @@map("api_keys")
  @@schema("users")
}

enum UserDataScope {
  SELF
  TEAM
  BRANCH
  ORGANIZATION
  SYSTEM

  @@map("data_scope")
  @@schema("users")
}

/// Append-only User Management audit log (platform-contracts.md §4).
model UserAuditLog {
  id            String        @id @default(uuid()) @db.Uuid
  occurredAt    DateTime      @default(now())
  actorType     UserActorType
  actorId       String?       @db.Uuid
  action        String        @db.VarChar(200)
  targetType    String        @db.VarChar(100)
  targetId      String        @db.Uuid
  correlationId String?       @db.Uuid
  beforeState   Json?         @db.JsonB
  afterState    Json?         @db.JsonB

  recordHash         String  @db.VarChar(128)
  previousRecordHash String? @db.VarChar(128)

  @@index([targetType, targetId])
  @@index([occurredAt])
  @@map("user_audit_log")
  @@schema("users")
}

enum UserActorType {
  USER
  SYSTEM
  AI

  @@map("user_actor_type")
  @@schema("users")
}
